# ============================================
# CLAUDE CODE SESSION AUTHENTICATION (REQUIRED)
# ============================================
# Get this by running 'claude /login' in your terminal
# Then export the session token
# DO NOT share this token - it's equivalent to your account

CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_session_token_here

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
# Create a bot via @BotFather on Telegram
# Send /newbot, give it a name, copy the token

TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# POLYMARKET MCP SERVER
# ============================================
# Public Gamma API - no authentication required

GAMMA_API_URL=https://gamma-api.polymarket.com
GAMMA_REQUIRES_AUTH=false

# ============================================
# COPY TRADING RULES
# ============================================
# Filter for profitable wallets only

# Minimum number of trades in last 90 days
MIN_TRADES_90D=20

# Minimum lifetime realized PnL in USD
MIN_LIFETIME_PNL=10000

# Minimum win rate (0.20 = 20%)
MIN_WIN_RATE=0.20

# Maximum number of wallets to follow simultaneously
MAX_POSITIONS=10

# Default position size per copy trade (in USDC)
POSITION_SIZE_USDC=50

# Whether to copy sells/exits (true/false)
COPY_SELLS=true

# How often to poll for new whale trades (in seconds)
POLL_INTERVAL_SECS=60

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string (auto-configured in Docker)

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/polymarket

# ============================================
# MCP SERVER URLS (INTERNAL DOCKER NETWORK)
# ============================================

MCP_TELEGRAM_URL=http://mcp-telegram:8765
MCP_POLYMARKET_URL=http://mcp-polymarket:8766

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=/app/logs/jev-ai.log